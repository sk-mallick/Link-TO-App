<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/themeColor</item>
        <item name="colorPrimaryDark">@color/themeColor</item>
        <item name="colorAccent">@color/themeColor</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        
        <!-- Hide the default Android 12+ Splash Screen Icon -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/empty_splash</item>
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
    </style>
</resources>
